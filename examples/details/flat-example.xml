      <TagRef tag="TAXCRED"/>
      <TagRef tag="RESHOOT"/>
    </Movement>
    <Movement chapterCode="2400" accountCode="2402" type="PO" date="2026-12-05"
              payeeRef="C2001" department="CAM" producer="SCP" itemRef="B005"
              documentNumber="PO-2026-0312" description="Camera package, remaining shoot"
              ordered="36000"/>
    <Movement chapterCode="2400" accountCode="2403" type="INV" date="2026-12-11"
              payeeRef="C2002" department="LIGHT" producer="NWP" itemRef="B006"
              documentNumber="BLH-2026-119" documentDate="2026-12-09"
              description="Lighting package rental" spent="18000">
      <Document url="https://docs.example.com/invoices/BLH-2026-119.pdf" type="invoice"/>
    </Movement>
    <Movement chapterCode="2400" accountCode="2403" type="PAY" date="2026-12-13"
              payeeRef="P0104" role="GAFFER" department="LIGHT" producer="NWP" itemRef="B006"
              description="Gaffer weekly payroll" spent="4500"/>
  </Body>
</Details>
