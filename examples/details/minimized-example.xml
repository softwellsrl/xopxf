<?xml version="1.0" encoding="UTF-8"?>
<!-- Details, minimised form: the EXACT SAME Body as full-example.xml, but the
     Header omits the Parties registry. The payee codes (P0101, C2001, ...) still
     travel, but no name, tax id or city does: personal data never leaves the
     issuer. A reader sees only the codes. This is the GDPR-minimised transmission;
     it is as valid as the full form because payeeRef is a soft reference. -->
<Details xmlns="urn:xopxf:details:1.0" version="0.1.0" language="en">

  <Header>
    <Transmission>
      <Sender>
        <Name>Northwind Pictures Ltd</Name>
        <VatId>GB000000000</VatId>
      </Sender>
      <Recipient>
        <Name>Acme Broadcasting Group</Name>
      </Recipient>
      <DocumentId>NWP-LONGWINTER-DET-012-MIN</DocumentId>
      <IssueDate>2026-12-22</IssueDate>
    </Transmission>

    <Production>
      <Code>LONGWINTER</Code>
      <Title>The Long Winter</Title>
      <Episodes>8</Episodes>
      <Currency>EUR</Currency>
    </Production>

    <BudgetReference productionCode="LONGWINTER" revision="003"
                     documentId="NWP-LONGWINTER-BDG-003" date="2026-05-20"/>
    <CostReportReference documentId="NWP-LONGWINTER-CR-012" number="012" asOf="2026-12-20"/>

    <Groups>
      <Group scheme="line" code="ATL" name="Above the line"/>
      <Group scheme="line" code="BTL" name="Below the line"/>
    </Groups>

    <Departments>
      <Department code="CAST"  name="Cast"/>
      <Department code="CAM"   name="Camera"/>
      <Department code="LIGHT" name="Lighting"/>
    </Departments>

    <Producers>
      <Producer code="NWP" name="Northwind Pictures Ltd"/>
      <Producer code="SCP" name="Silverpeak Co-Production"/>
    </Producers>

    <Roles>
      <Role code="LEAD" name="Lead actor"/>
      <Role code="DOP"  name="Director of photography"/>
      <Role code="CAMOP" name="Camera operator"/>
      <Role code="GAFFER" name="Gaffer"/>
    </Roles>

    <MovementTypes>
      <MovementType code="INV" name="Supplier invoice"/>
      <MovementType code="PO"  name="Purchase order"/>
      <MovementType code="PAY" name="Payroll" payroll="true"/>
      <MovementType code="VAR" name="Variation"/>
    </MovementTypes>

    <!-- No Parties element: counterparty identities are intentionally withheld. -->
  </Header>

  <Body>

    <Chapter code="1300" name="Principal cast">
      <GroupRef group="ATL"/>
      <Account code="1301" name="Lead cast" externalCode="013.001">
        <Movement type="PAY" date="2026-11-30" payeeRef="P0101" role="LEAD"
                  department="CAST" producer="NWP" itemRef="A004"
                  description="Lead actor fee, November instalment"
                  spent="60000" net="50000" charges="10000" gross="60000">
          <Document url="https://docs.example.com/payslips/P0101-2026-11.pdf" type="payslip"/>
        </Movement>
        <Movement type="PAY" date="2026-11-30" payeeRef="P0101" role="LEAD"
                  department="CAST" producer="NWP" itemRef="A004"
                  documentNumber="ADV-A004-02"
                  description="Lead actor fee, advance"
                  spent="60000" net="50000" charges="10000" gross="60000"/>
      </Account>
    </Chapter>

    <Chapter code="2400" name="Camera and lighting">
      <GroupRef group="BTL"/>
      <Account code="2401" name="Camera crew" externalCode="024.001">
        <Movement type="PAY" date="2026-12-13" payeeRef="P0102" role="DOP"
                  department="CAM" producer="NWP" itemRef="B003"
                  description="DoP weekly payroll"
                  spent="9750" net="7800" charges="1950" gross="9750"/>
        <Movement type="PAY" date="2026-12-13" payeeRef="P0103" role="CAMOP"
